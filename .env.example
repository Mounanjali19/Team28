# Copy to .env and adjust. scripts/run.sh loads it. Nothing here is required for the demo.

# Signing key for login tokens. Unset -> a random key per process (sessions end on restart).
ALTCREDIT_SECRET_KEY=
# Shared key between AltCredit and the mock bank. Unset -> scripts/run.sh generates one per run.
ALTCREDIT_BANK_API_KEY=
ALTCREDIT_BANK_API_URL=http://127.0.0.1:8001
# Password given to every seeded demo account (applied when you run scripts/seed.py).
ALTCREDIT_DEMO_PASSWORD=
# 1 = one-click demo logins on the sign-in page; 0 = disable them.
ALTCREDIT_DEMO_MODE=1
# Paths (defaults shown)
# ALTCREDIT_DB=data/altcredit.db
# ALTCREDIT_DATASET_DIR=../Datasets_AltCredit_v2
# ALTCREDIT_LEGACY_DATASET_DIR=../Datasets_AltCredit
# ALTCREDIT_MODELS_DIR=models
ALTCREDIT_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
ALTCREDIT_TOKEN_TTL_MINUTES=480
# Mock bank: seconds an application stays UNDER_REVIEW before a decision.
MOCKBANK_REVIEW_SECONDS=8
